{
  "trailingSlash": false,
  "rewrites": [
    { "source": "/ozellikler", "destination": "/index.html" },
    { "source": "/nasil", "destination": "/index.html" },
    { "source": "/pro", "destination": "/index.html" },
    { "source": "/indir", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
